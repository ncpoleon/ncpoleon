"""Type stubs for the MOSEK Fusion API (``mosek.fusion``), MOSEK 11.2.

MOSEK ships ``mosek.fusion`` as a compiled extension (``_msk*.so``) whose Python
classes are built at import time by factory functions, so a type checker sees
nothing but ``Unknown`` there. Every declaration below was recovered from the
installed package: the class hierarchy from ``__mro__``, the accepted argument
lists from the ``Syntax`` block that MOSEK puts in each method's ``__doc__``,
and the return types by constructing a model and inspecting what came back.

Fusion methods are Java-style overload dispatchers with a bare ``*args``
runtime signature, so the overloads here are transcriptions of those ``Syntax``
blocks rather than anything introspection could produce on its own.

Only the parts of Fusion this project uses are covered in depth; the rest is
declared broadly enough to stay out of the way.
"""

from collections.abc import Sequence
from types import TracebackType
from typing import IO, Any, Final, TypeAlias, final, overload

import numpy as np
import numpy.typing as npt

# MOSEK's docs spell the array parameters as `array(double,ndim=1)` and
# `array(int32,ndim=1)`. Fusion accepts any Python sequence there as well as a
# NumPy array, and int sequences wherever doubles are wanted.
_Int1D: TypeAlias = Sequence[int] | npt.NDArray[np.integer[Any]]
_Int2D: TypeAlias = Sequence[Sequence[int]] | npt.NDArray[np.integer[Any]]
_Float1D: TypeAlias = Sequence[float] | npt.NDArray[np.floating[Any] | np.integer[Any]]
_Float2D: TypeAlias = Sequence[Sequence[float]] | npt.NDArray[np.floating[Any] | np.integer[Any]]

# Anything Fusion will treat as constant data on one side of an operator.
_Data: TypeAlias = float | _Float1D | _Float2D | Matrix | NDSparseArray | Parameter

# ---------------------------------------------------------------------------
# Enums
#
# At runtime these are `int` subclasses generated by a factory, exposing their
# members as class attributes plus `fromInt`/`members`/`new`.
# ---------------------------------------------------------------------------

class _Enum(int):
    @classmethod
    def fromInt(cls, v: int) -> Any: ...
    @classmethod
    def members(cls) -> list[Any]: ...

@final
class ObjectiveSense(_Enum):
