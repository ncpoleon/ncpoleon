    IllposedCert: Final[SolutionStatus]

@final
class AccSolutionStatus(_Enum):
    Anything: Final[AccSolutionStatus]
    Certificate: Final[AccSolutionStatus]
    Feasible: Final[AccSolutionStatus]
    Optimal: Final[AccSolutionStatus]

@final
class ProblemStatus(_Enum):
