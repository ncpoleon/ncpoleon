# ---------------------------------------------------------------------------
# Expressions
#
# The dunder methods, `.T`, `.F` and `.shape` below do not exist on a bare
# `import mosek.fusion`: `mosek/fusion/pythonic.py` monkey-patches them onto
# these classes. They are declared here rather than in `pythonic.pyi` because a
# stub cannot express "importing this module widens that class", and every
# module in this project that touches Fusion imports `mosek.fusion.pythonic`.
# ---------------------------------------------------------------------------

class Expression:
    @property
    def T(self) -> Expression: ...
    @property
    def F(self) -> Expression: ...
    @property
    def shape(self) -> npt.NDArray[np.int32]: ...
    def getShape(self) -> npt.NDArray[np.int32]: ...
    def getND(self) -> int: ...
    def getSize(self) -> int: ...
    def getDim(self, d: int) -> int: ...
    def getModel(self) -> Model: ...
    def toString(self) -> str: ...
    @overload
    def index(self, i: int) -> Expression: ...
    @overload
    def index(self, idx: _Int1D) -> Expression: ...
    @overload
    def slice(self, first: int, last: int) -> Expression: ...
    @overload
    def slice(self, first: _Int1D, last: _Int1D) -> Expression: ...
    @overload
    def pick(self, idx: _Int1D) -> Expression: ...
    @overload
    def pick(self, idx: _Int2D) -> Expression: ...
    def __getitem__(self, key: Any) -> Expression: ...
    def __add__(self, other: Expression | _Data) -> Expression: ...
    def __radd__(self, other: _Data) -> Expression: ...
    def __sub__(self, other: Expression | _Data) -> Expression: ...
    def __rsub__(self, other: _Data) -> Expression: ...
    def __mul__(self, other: Expression | _Data) -> Expression: ...
    def __rmul__(self, other: _Data) -> Expression: ...
    def __matmul__(self, other: Expression | _Data) -> Expression: ...
    def __rmatmul__(self, other: _Data) -> Expression: ...
    def __truediv__(self, other: float) -> Expression: ...
    def __neg__(self) -> Expression: ...
    def __pos__(self) -> Expression: ...
    # `expr == domain` means membership and `expr == expr` means equality; both
    # yield a clause for `Model.constraint`, never a bool. Returning a non-bool
    # is incompatible with `object.__eq__` by construction, hence the ignore.
    @overload
    def __eq__(self, other: PSDDomain) -> ExprPSDDomain: ...
    @overload
    def __eq__(self, other: ConeDomain) -> ExprConicDomain: ...
    @overload
    def __eq__(self, other: RangeDomain) -> ExprRangeDomain: ...
    @overload
    def __eq__(  # ty: ignore[invalid-method-override]
        self, other: Expression | LinearDomain | _Data
    ) -> ExprLinearDomain: ...
    def __le__(self, other: Expression | _Data) -> ExprLinearDomain: ...
    def __ge__(self, other: Expression | _Data) -> ExprLinearDomain: ...
    def __hash__(self) -> int: ...

class BaseExpression(Expression): ...

